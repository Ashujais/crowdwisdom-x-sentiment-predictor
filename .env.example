# ==============================================================================
# CrowdWisdomTrading X Sentiment Price Prediction Agent - Environment Config
# ==============================================================================

# Target Asset Configuration
TARGET_ASSET=TSLA
ASSET_NAME=Tesla, Inc.
LOOKBACK_DAYS=180
INTERVAL=1d

# Apify Scraping Configuration
# Sign up at https://apify.com to get your API token.
APIFY_API_TOKEN=your_apify_api_token_here
# Recommended Apify Actor ID for Twitter/X scraping:
APIFY_ACTOR_ID=apidojo/tweet-scraper
# Alternative Actor IDs tested:
# - kaitoeasyapi/twitter-x-data-tweet-scraper-pay-per-result-cheapest
# - microworlds/twitter-scraper
APIFY_MAX_ITEMS=3000

# Tavily News API Configuration
# Sign up at https://tavily.com to obtain your API key.
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_SEARCH_DAYS=30

# Exa API Configuration (Optional alternative search engine)
EXA_API_KEY=your_exa_api_key_here

# Walk-Forward Validation & Backtesting
WFV_TRAIN_WINDOW=60
WFV_TEST_WINDOW=15
PURGE_WINDOW=5
INITIAL_CAPITAL=100000.0
TRANSACTION_COST_BPS=10.0
RISK_FREE_RATE=0.045
